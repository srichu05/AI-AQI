# Environment Configuration for AI-AQI Cloud / Container Deployment
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS=*

# Model & Database Settings
MODEL_PATH=experiments/final_model/best_dl_model.keras

# PostgreSQL Database URL
DATABASE_URL=sqlite:///./ai_aqi_telemetry.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth Configuration (ES256 JWKS Verification)
# Copy "Project URL" from Supabase Dashboard -> Project Settings -> API Keys / General
SUPABASE_URL=https://your-project-ref.supabase.co
